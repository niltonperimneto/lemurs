{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lemurs-config-editor",
  "version": "0.1.0",
  "identifier": "com.lemurs.configeditor",
  "build": {
    "frontendDist": "../src-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Lemurs Config",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}